# URL publique de l'application (utilisée dans les liens des relances et des emails)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# BASE DE DONNÉES TURSO (libSQL) — OBLIGATOIRE EN PRODUCTION
# ---------------------------------------------------------------------------
# Créer une base sur https://turso.tech puis copier son URL et son token.
# La table loutigui_state est créée automatiquement au premier accès.
TURSO_DATABASE_URL=libsql://votre-base.turso.io
TURSO_AUTH_TOKEN=
#
# Pour un test local sans cloud : TURSO_DATABASE_URL=file:data/loutigui.db
# DATABASE_URL est accepté comme alias uniquement s'il contient une URL
# libSQL (libsql://…, file:…). Les URL PostgreSQL sont refusées.
#
# Sans URL configurée, l'application utilise data/db.json en développement.

# ---------------------------------------------------------------------------
# SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# ---------------------------------------------------------------------------
# Clé de signature des cookies de session (32 caractères aléatoires minimum).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Secret du cron de relances automatiques (en-tête Authorization: Bearer <secret>)
CRON_SECRET=

# ---------------------------------------------------------------------------
# ABONNEMENTS — SasPay
# ---------------------------------------------------------------------------
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PAIEMENT DES LOYERS — passerelle Mobile Money générique
# Aucun paiement n'est confirmé sans webhook signé.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# live | test
PAYMENT_MODE=test

# ---------------------------------------------------------------------------
# SMS — choisir un fournisseur : twilio | generic
# ---------------------------------------------------------------------------
SMS_PROVIDER=twilio
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Passerelle HTTP générique (JSON : { to, from, text })
# SMS_GATEWAY_URL=https://api.exemple.ci/sms/send
# SMS_GATEWAY_API_KEY=
# SMS_GATEWAY_FROM=LOUTIGUI

# ---------------------------------------------------------------------------
# EMAIL — choisir un fournisseur : resend | brevo | sendgrid
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# ou
# BREVO_API_KEY=
# ou
# SENDGRID_API_KEY=
# Domaine vérifié dans le compte du fournisseur :
EMAIL_FROM=notifications@votre-domaine.tld
EMAIL_FROM_NAME=LOUTIGUI
